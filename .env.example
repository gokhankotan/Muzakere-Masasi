# ==============================================================================
# MÜZAKERE MASASI - ÖRNEK ORTAM DEĞİŞKENLERİ YAPILANDIRMASI (.env.example)
# ==============================================================================

# Sunucu Port Yapılandırması (Varsayılan: 3001)
PORT=3001

# JWT Gizli Anahtarı (Production'da rastgele karmaşık bir dize belirleyin)
JWT_SECRET=kamusal_alan_gizli_anahtar

# Veritabanı Bağlantı Cümlesi (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/muzakeredb?schema=public"

# ------------------------------------------------------------------------------
# LLM (Yapay Zeka) UÇ NOKTA YAPILANDIRMASI
# ------------------------------------------------------------------------------
# Google Gemini / OpenAI Uyumlu API Key
LLM_API_KEY=your_gemini_or_openai_api_key_here

# Kullanılacak LLM Modeli (Örn: gemini-2.5-flash-lite, gpt-4o-mini)
LLM_MODEL=gemini-2.5-flash-lite

# LLM Base URL (Google Gemini OpenAI Uyumlu Uç Nokta)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Test / Çevrimdışı Çalışma Modu ('true' ise LLM çağrısı yapılmaz, kural tabanlı fallback üretilir)
LLM_DRY_RUN=false

# ------------------------------------------------------------------------------
# PERFORMANS VE MUTASYON EŞİK AYARLARI
# ------------------------------------------------------------------------------
# LLM Analizini Tetikleyecek Birikmiş Oy Sayısı Eşiği (Default: 5)
MUTATION_THRESHOLD_VOTES=5

# LLM Analizini Tetikleyecek Birikmiş Onaylı Görüş Sayısı Eşiği (Default: 2)
MUTATION_THRESHOLD_OPINIONS=2

# ------------------------------------------------------------------------------
# AZINLIK GÖRÜŞÜ KORUMASI (MINORITY INSIGHTS SHIELD) EŞİKLERİ
# ------------------------------------------------------------------------------
# Azınlık Görüşü Seçimi İçin Gereken Minimum Gerekçe Kalite Skoru (0-100, Default: 25)
MINORITY_MIN_SCORE=25

# Azınlık Görüşü Seçimi İçin Katılımcılar Tarafından Oylanmış Minimum Oy Eşiği (Default: 3)
MINORITY_MIN_VOTES=3
